{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jig-harness.dev/protocol/steward-records/v1/schemas/steward-need.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "need"
    },
    "target": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\S)(?:[\\u0000-\\uD7FF\\uE000-\\uFFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\u0000-\\uFFFF]){1,4000}$",
      "maxLength": 4000
    },
    "act": {
      "enum": ["Merge", "Decide", "Authorize", "Reply", "Do", "Investigate"]
    },
    "ask": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\S)(?:[\\u0000-\\uD7FF\\uE000-\\uFFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\u0000-\\uFFFF]){1,4000}$",
      "maxLength": 4000
    },
    "reason": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\S)(?:[\\u0000-\\uD7FF\\uE000-\\uFFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\u0000-\\uFFFF]){1,4000}$",
      "maxLength": 4000
    }
  },
  "required": ["kind", "target", "act", "ask", "reason"],
  "additionalProperties": false
}
