{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jig-harness.dev/protocol/repo-commands/v1/schemas/followup-verdict.json",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": ["owed", "not-owed", "pending", "unread"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "string"
    }
  },
  "required": ["verdict", "evidence"],
  "additionalProperties": true
}
