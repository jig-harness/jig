        "type": {
          "const": "finding"
        },
        "change": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "\\S"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pull_request": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "issue": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["repository", "branch", "pull_request", "issue"],
          "additionalProperties": true
