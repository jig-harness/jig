{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jig-harness.dev/protocol/steward-records/v1/schemas/steward-order.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "order"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=[\\s\\S]*\\S)(?:[\\u0000-\\uD7FF\\uE000-\\uFFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\u0000-\\uFFFF]){1,4000}$",
        "maxLength": 4000
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "pattern": "^(?=[\\s\\S]*\\S)(?:[\\u0000-\\uD7FF\\uE000-\\uFFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\u0000-\\uFFFF]){1,4000}$",
      "maxLength": 4000
    }
  },
  "required": ["kind", "targets", "reason"],
  "additionalProperties": false
}
