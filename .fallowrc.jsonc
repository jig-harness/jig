{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Scripts that a SKILL.md, a gate or CI runs by path. Nothing imports them,
  // so without this list fallow would report every one as an unused file.
  "entry": [
    "scripts/**/*.ts",
    "audit/**/*.ts",
    "tools/**/*.ts",
    "dashboard/build.ts",
    "dashboard/serve-fixture.ts",
    // The page's own entry, which the dashboard's build hands to the bundler.
    "dashboard/src/main.tsx",
    "plugin/skills/*/scripts/**/*.ts",
    "modules/*/reference/**/*.ts"
  ],
  "ignorePatterns": [
    "**/fixtures/**",
    "**/templates/**",
    "**/vendor/**",
    "seeds/**",
    "dist/**",
    ".context/**"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "duplicate-exports": "warn",
    // CRAP weighs complexity by test coverage. Bun writes coverage only as
    // lcov, which fallow does not read, so fallow estimates coverage from the
    // import graph; a score built on that guess informs but does not gate.
    "complexity-crap": "warn"
  },
  "duplicates": {
    "mode": "mild"
  },
  // `fallow audit` keeps a snapshot of the base per checkout in the temp
  // directory and never removes it with the checkout. The `audit` script in
  // package.json points TMPDIR at node_modules/.cache/fallow so the snapshot
  // lives and dies with the checkout instead of piling up in a shared /tmp,
  // where a host running many worktrees ran out of inodes.
  "audit": {
    "gate": "new-only"
  }
}
