{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.json",
      "!**/fixtures/**",
      "!**/templates/**",
      "!seeds/**",
      "!docs/**",
      "!.context/**",
      "!dist/**",
      "!renovate.json5"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": false
  }
}
