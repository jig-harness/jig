{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!**/fixtures/**",
      "!**/templates/**",
      "!seeds/**",
      "!docs/**",
      "!.context/**",
      "!dist/**",
      "!renovate.json5"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "none"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessCatch": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "warn",
        "useErrorMessage": "error"
      }
    }
  },
  "plugins": [
    {
      "path": "./modules/M15-contracts-errors/reference/lint-rules/json-parse-cast.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./modules/M15-contracts-errors/reference/lint-rules/catch-return-default.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./modules/M15-contracts-errors/reference/lint-rules/stderr-ignore.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./modules/M15-contracts-errors/reference/lint-rules/no-bare-throw-error.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./modules/M15-contracts-errors/reference/lint-rules/no-message-branch.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./tools/quality/grit/no-local-record-guard.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./tools/quality/grit/no-raw-exit.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./tools/quality/grit/no-bare-signal-handlers.grit",
      "includes": ["**/*.ts", "!**/__tests__/**", "!**/*.test.ts"]
    },
    {
      "path": "./tools/quality/grit/no-bare-exit-code-assertion.grit",
      "includes": ["**/*.test.ts", "**/__tests__/**/*.ts"]
    }
  ],
  "overrides": [
    {
      "includes": ["dashboard/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}
