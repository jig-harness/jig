    "@biomejs/biome": "2.6.4",
    "@optique/core": "1.3.6",
    "@tanstack/markdown": "1.0.1",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.25",
    "@types/bun": "1.4.4",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fallow": "3.38.1",
    "happy-dom": "21.0.4",
    "js-yaml": "4.3.2",
