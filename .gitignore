# Editor / IDE local state. Jig is vendor-neutral by design (module M0):
# no contributor should need a particular IDE, and none should have to see
# anyone else than their own IDE state in a diff.
.idea/
.vscode/
*.iml

# Local evidence and installed/build outputs.
.context/
