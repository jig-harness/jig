{
  "name": "jig-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun scripts/audit-example.ts && bun --bun astro build && bun scripts/markdown-twins.ts && bun scripts/check-links.ts",
    "check": "bun --bun astro check",
    "preview": "bun --bun astro preview",
    "deploy": "bun run build && bunx --bun wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "^7.3.8",
    "mdast-util-from-markdown": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "typescript": "^6",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.150.0"
  }
}
