{
  "name": "jig-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun scripts/audit-example.ts && bun --bun astro build && bun scripts/check-links.ts",
    "check": "bun --bun astro check",
    "preview": "bun --bun astro preview",
    "deploy": "bun run build && bunx --bun wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "^7.3.8",
    "mdast-util-from-markdown": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.3",
    "@types/mdast": "^4.0.4",
    "typescript": "^6",
    "wrangler": "^4.150.0"
  }
}
