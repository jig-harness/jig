---
// The adopt section's pages, as a switch between them: getting started, the
// adoption guides, and the plugin's reference pages.
import PageSwitch from "./PageSwitch.astro";

type AdoptPage = "start" | "existing" | "new" | "plugin" | "configuration" | "extending";

interface Props {
  current: AdoptPage;
}
const { current } = Astro.props;
const tabs: { key: AdoptPage; label: string; href: string }[] = [
  { key: "start", label: "Getting started", href: "/adopt/" },
  { key: "existing", label: "Existing repository", href: "/adopt/existing/" },
  { key: "new", label: "New project", href: "/adopt/greenfield/" },
  { key: "plugin", label: "The plugin", href: "/adopt/plugin/" },
  { key: "configuration", label: "Configuration", href: "/adopt/configuration/" },
  { key: "extending", label: "Extending", href: "/adopt/extending/" },
];
---

<PageSwitch label="Adopt" pages={tabs} current={current} />
