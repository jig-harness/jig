---
// A plate: one of the site's line drawings (public/plates/), drawn in the
// ink token so it follows the theme. The file is an alpha mask, black ink on
// transparent; the mask is painted with the ink color at a set tone. Plates
// decorate; every fact beside one is in the text, so they carry no alt.
import { PLATES, type PlateName } from "../lib/plates.ts";

interface Props {
  /** The file under public/plates/, without the extension. */
  name: PlateName;
  /** The rendered width; the height follows the plate's own ratio. */
  width?: string;
  /** How dark the ink is drawn: 1 is the text color. */
  tone?: number;
  class?: string;
}
const { name, width = "100%", tone = 0.82, class: cls } = Astro.props;
const style = `--plate:url(/plates/${name}.webp);aspect-ratio:${PLATES[name]};width:${width};opacity:${tone}`;
---

<span class:list={["plate", cls]} style={style} aria-hidden="true"></span>

<style>
  .plate {
    display: block;
    max-width: 100%;
    background: var(--ink);
    -webkit-mask: var(--plate) center / contain no-repeat;
    mask: var(--plate) center / contain no-repeat;
  }
</style>
