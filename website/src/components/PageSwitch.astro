---
// A switch between sibling pages: one link per page, the current one marked.
interface Props {
  label: string;
  pages: readonly { key: string; label: string; href: string }[];
  current: string;
}
const { label, pages, current } = Astro.props;
---

<nav aria-label={label}>
  {pages.map((t) => <a href={t.href} aria-current={t.key === current ? "page" : undefined}>{t.label}</a>)}
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 26px;
  }
  a {
    padding: 9px 14px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14.5px;
    color: var(--ink);
    white-space: nowrap;
  }
  a + a {
    border-left: 1px solid var(--line-strong);
  }
  a:hover {
    background: var(--sunk);
  }
  a[aria-current="page"] {
    background: var(--accent-soft);
    box-shadow: inset 0 -2px 0 var(--accent);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    nav {
      width: 100%;
    }
    a {
      flex: 1 1 auto;
      text-align: center;
      padding: 8px 10px;
      font-size: 13.5px;
    }
    a + a {
      border-left: 0;
    }
  }
</style>
