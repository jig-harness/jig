---
// The whole map: every module at its three levels, in id order, with a
// profile's targets filled in. `compact` is the home page's
// form (one link per row); `full` is the modules page's (titles, areas,
// scaffolding jobs, the skills that run each module, a note per row).
import { mapSummary } from "../lib/map.ts";
import CompactMap from "./map/CompactMap.astro";
import FullMap from "./map/FullMap.astro";

interface Props {
  variant: "compact" | "full";
}
const { variant } = Astro.props;
const { profiles, lines } = mapSummary();
const full = variant === "full";
---

<div class:list={["map", variant]} data-map>
  <div class="switch-row">
    {full && <span class="switch-label">Show the targets of</span>}
    <div class="pills" role="radiogroup" aria-label="Show the targets of a profile" data-map-switch hidden>
      {
        profiles.map((prof, i) => (
          <button type="button" role="radio" aria-checked={i === 0} data-profile={i}>
            {prof.name}
          </button>
        ))
      }
    </div>
    {
      full &&
        lines.map((line, i) => (
          <span class="summary" data-for-profile={i} hidden={i !== 0}>
            {line}
          </span>
        ))
    }
  </div>
  {full ? <FullMap /> : <CompactMap />}
</div>

<script>
  import "../scripts/map.ts";
</script>

<style>
  .switch-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .switch-label {
    font-size: 14px;
    font-weight: 500;
  }
  .full .pills button {
    font-size: 14px;
    padding: 7px 12px;
    min-height: 36px;
  }
  .summary {
    font-size: 14px;
    color: var(--muted);
  }
</style>
