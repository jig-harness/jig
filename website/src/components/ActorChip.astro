---
// One actor as a chip that says what it is: `/name` for a skill, `@name`
// for an agent, `>name` for a tool, a silhouette for a person, a dashed
// chip for work on the roadmap. Hovering or focusing it opens what the actor
// does (scripts/site.ts), and it links to the actor's page.
import type { Actor } from "../lib/data/factory.ts";
import { actorTip, roadmapLabel, tipData } from "../lib/actor-tip.ts";
import StatusMark from "./StatusMark.astro";

interface Props {
  actor: Actor;
}
const { actor } = Astro.props;
const tip = actorTip(actor);
const GLYPH: Partial<Record<Actor["kind"], string>> = { skill: "/", agent: "@", tool: ">", todo: "⋯" };
---

<a class:list={["achip", actor.kind]} href={tip.href} {...tipData(tip)}>
  <span class="vh">{tip.said}</span>
  {actor.kind === "person" ? <StatusMark kind="person" size={12} /> : <span class="pre" aria-hidden="true">{GLYPH[actor.kind]}</span>}
  <span class="name">{actor.kind === "person" ? "a person" : actor.kind === "todo" ? roadmapLabel(actor.item) : actor.name}</span>
</a>

<style>
  .achip {
    display: inline;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.9;
    text-decoration: none;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 1px 8px 1px 6px;
    overflow-wrap: break-word;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .achip:hover,
  .achip:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .pre {
    color: var(--accent);
    font-weight: 700;
    margin-right: 2px;
  }
  .person {
    font-family: var(--sans);
    font-weight: 600;
    border-color: var(--ink);
    padding-left: 7px;
    white-space: nowrap;
  }
  .person :global(.mark) {
    margin-right: 4px;
  }
  .todo {
    border-style: dashed;
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
  }
  .todo .pre {
    color: var(--muted);
    letter-spacing: -0.1em;
  }
</style>
