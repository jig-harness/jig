---
// The live audit example: a real audit sheet, rendered at build by the audit
// skill from a committed run (scripts/audit-example.ts), shown as the
// artifact it is. It rests inert so the page keeps its scroll; a click makes
// it usable, and it opens full screen or in its own tab.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const src = "/examples/audit/execa-63ddae6.html";
const title = "Audit sheet for sindresorhus/execa at commit 63ddae6, audited with Jig plugin v0.15.0 on 12 Oct 2026, rendered by the current audit skill";
---

<figure class:list={["specimen", { compact }]} aria-label="A real audit sheet" data-specimen>
  <figcaption class="cap">
    <span class="real">Real output · not this site</span>
    <dl>
      <div><dt>Repository</dt><dd><a class="ext" href="https://github.com/sindresorhus/execa">sindresorhus/execa ↗</a></dd></div>
      <div><dt>Commit</dt><dd class="mono"><a class="ext" href="https://github.com/sindresorhus/execa/tree/63ddae6">63ddae6 ↗</a></dd></div>
      <div><dt>Audited with</dt><dd>plugin v0.15.0</dd></div>
      <div><dt>Run</dt><dd>12 Oct 2026</dd></div>
      <div><dt>Rendered by</dt><dd>the current audit skill</dd></div>
    </dl>
    <span class="grow"></span>
    <span class="actions">
      <span class="live-note" data-live-note hidden>Scrolling inside the sheet</span>
      <button type="button" class="pill" data-done hidden>Done</button>
      <button type="button" class="pill primary" data-expand hidden>Expand to full screen</button>
      <a class="ext" href={src} target="_blank" rel="noopener">Open in its own tab ↗</a>
    </span>
  </figcaption>
  <div class="frame">
    <iframe src={src} title={title} loading="lazy" allow="clipboard-write" tabindex="-1" data-sheet></iframe>
    <button type="button" class="cover" data-use aria-label="Use the audit sheet here: scroll it and mark decisions">
      <span>Click to scroll the sheet and try its decisions</span>
    </button>
  </div>
  <p class="note">
    This is the audit's own page: the audit skill renders it from that run's record each time the site is built, so its
    findings are the run's and its look is the current sheet's, not this site's. It makes no network requests; the decisions you mark and copy stay in your browser and are sent nowhere.
  </p>
  <dialog class="full" aria-label="Example audit sheet, full screen" data-full>
    <div class="full-bar">
      <span class="real">Real output · not this site</span>
      <span class="mono">sindresorhus/execa @ 63ddae6 · audited with plugin v0.15.0 · run 12 Oct 2026</span>
      <span class="muted">Decisions stay in your browser.</span>
      <span class="grow"></span>
      <a class="ext" href={src} target="_blank" rel="noopener">Open in its own tab ↗</a>
      <button type="button" class="pill" data-close>Close <span class="muted">Esc</span></button>
    </div>
    <iframe title={`${title}, full screen`} allow="clipboard-write" data-full-sheet></iframe>
  </dialog>
</figure>

<script>
  import "../scripts/specimen.ts";
</script>

<style>
  .specimen {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--sunk);
    padding: 0 10px 10px;
  }
  .cap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: center;
    padding: 12px 4px;
  }
  .real {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--card);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    padding: 4px 8px;
    border-radius: var(--r-tag);
    font-weight: 600;
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
  }
  dt {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .mono {
    font-family: var(--mono);
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 14px;
  }
  .live-note {
    font-size: 13px;
    background: var(--accent-soft);
    padding: 4px 8px;
    border-radius: var(--r);
    font-weight: 500;
  }
  .pill {
    font: 600 13.5px var(--sans);
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
    min-height: 36px;
  }
  .pill:hover {
    border-color: var(--accent);
  }
  .pill.primary {
    border: 1.5px solid var(--accent);
    background: var(--accent-soft);
  }
  .pill.primary:hover {
    background: var(--card);
  }
  .ext:hover {
    color: var(--accent-hover);
  }
  .frame {
    position: relative;
    height: clamp(440px, 44vw, 620px);
    background: var(--card);
    border: 1px solid var(--line);
  }
  .compact .frame {
    height: clamp(360px, 36vw, 480px);
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .frame iframe {
    pointer-events: none;
  }
  .frame.live iframe {
    pointer-events: auto;
  }
  .cover {
    position: absolute;
    inset: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 18px;
  }
  .cover span {
    font: 500 13.5px var(--sans);
    background: var(--accent);
    color: var(--on-accent);
    padding: 8px 14px;
    border-radius: var(--r);
    box-shadow: 0 6px 18px var(--shadow);
  }
  .cover:hover span {
    background: var(--accent-hover);
  }
  .frame.live .cover {
    display: none;
  }
  .note {
    margin: 10px 4px 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 96ch;
  }
  .full {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--outer);
    color: var(--ink);
  }
  .full[open] {
    display: flex;
    flex-direction: column;
  }
  .full-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: center;
    padding: 10px clamp(16px, 2.4vw, 28px);
    font-size: 13.5px;
  }
  .full iframe {
    flex: 1;
  }
  @media (max-width: 760px) {
    .frame {
      display: none;
    }
    [data-expand] {
      display: none;
    }
  }
</style>
