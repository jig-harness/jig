---
// The two adoption guides, as a switch between their pages.
import PageSwitch from "./PageSwitch.astro";

interface Props {
  current: "existing" | "new";
}
const { current } = Astro.props;
const tabs = [
  { key: "existing", label: "Existing repository", href: "/adopt/" },
  { key: "new", label: "New project", href: "/adopt/greenfield/" },
];
---

<PageSwitch label="Adoption guides" pages={tabs} current={current} />
