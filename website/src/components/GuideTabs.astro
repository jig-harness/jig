---
// The two adoption guides, as a switch between their pages.
interface Props {
  current: "existing" | "new";
}
const { current } = Astro.props;
const tabs = [
  { key: "existing", label: "Existing repository", href: "/adopt/" },
  { key: "new", label: "New project", href: "/adopt/greenfield/" },
];
---

<nav class="guides" aria-label="Adoption guides">
  {tabs.map((t) => <a href={t.href} aria-current={t.key === current ? "page" : undefined}>{t.label}</a>)}
</nav>

<style>
  .guides {
    display: flex;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 22px;
  }
  a {
    padding: 9px 14px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14.5px;
    color: var(--ink);
  }
  a + a {
    border-left: 1px solid var(--line-strong);
  }
  a:hover {
    background: var(--sunk);
  }
  a[aria-current="page"] {
    background: var(--accent-soft);
    box-shadow: inset 0 -2px 0 var(--accent);
    font-weight: 600;
  }
</style>
