---
// One recorded run of Jig's own line, as a timeline: each event's time,
// the station it happened at (linked into the factory), who acted, what
// happened and where it is written down. It is an ordered list of short
// paragraphs whose separators are text, so it reads in order without
// scripts, without styles and in the page's Markdown twin. The run is
// website/src/data/walkthrough.yaml, checked by its parser against
// FACTORY.md's stations.
import { factory, walkthrough } from "../lib/data/index.ts";
import ActorChip from "./ActorChip.astro";
import StatusMark from "./StatusMark.astro";

const run = walkthrough();
const stationIds = new Map(factory().line.map((s) => [s.name, s.id]));
const stationHref = (name: string) => {
  const id = stationIds.get(name);
  if (!id) throw new Error(`the walkthrough names station ${name}, which FACTORY.md's line has no more`);
  return `/factory/#station-${id}`;
};
const day = new Date(`${run.date}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const hhmm = (at: string) => at.startsWith(run.date)
  ? at.slice(11, 16)
  : `${at.slice(0, 10)} ${at.slice(11, 16)}`;
const prNumber = (url: string) => url.slice(url.lastIndexOf("/") + 1);
---

<div class="walk">
  <p class="walk-meta">
    <time datetime={run.date}>{day}</time> · <a href={run.pr.url}>Pull request #{run.pr.number} on GitHub</a> · times
    in UTC
  </p>
  <ol class="walk-list">
    {
      run.events.map((e) => (
        <li class:list={["ev", e.by.kind]}>
          <p class="ev-head">
            <span class="ev-time"><time datetime={e.at}>{hhmm(e.at)}</time>{e.until && <>–<time datetime={e.until}>{hhmm(e.until)}</time></>}</span> · <a class="ev-station label" href={stationHref(e.station)}>{e.station}</a>
          </p>
          <p class="ev-body">
            {e.by.kind === "skill" && <ActorChip actor={{ kind: "skill", name: e.by.name }} />}
            {e.by.kind === "person" && <ActorChip actor={{ kind: "person" }} />}
            {e.by.kind === "agent" && <span class="ev-actor"><StatusMark kind="agent" size={12} />an agent</span>}
            {e.by.kind === "dispatcher" && <a class="ev-actor" href="/adopt/plugin/#the-dispatcher"><StatusMark kind="tool" size={12} />the dispatcher</a>}: <span class="ev-what">{e.what}{e.link && <> <a href={e.link}>#{prNumber(e.link)}</a></>}</span>
          </p>
          <p class="ev-rec">Record: {e.record}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* A rule down the left with a mark per event; the time beside the station,
     then who acted and what happened, then where it is recorded, all three
     indented past the time. The " · " and ": " between the parts are text,
     for a reader without styles, and drawn at size 0 here: the parts are
     set apart by their own styling. */
  .walk {
    --time-w: 92px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .walk-meta {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .walk-meta time {
    color: var(--ink);
    font-weight: 600;
  }
  .walk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line-strong);
  }
  .ev {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 0 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .ev::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 15px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
  }
  /* The stops a person or the dispatcher makes stand out on the rule. */
  .ev.person::before {
    background: var(--ink);
    border-color: var(--ink);
  }
  .ev.dispatcher::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .ev p {
    margin-block: 0;
  }
  .ev-head,
  .ev-body {
    font-size: 0;
  }
  .ev-time {
    display: inline-block;
    min-width: var(--time-w);
    padding-right: 8px;
    font: 600 13px var(--mono);
    color: var(--ink);
    white-space: nowrap;
  }
  .ev-station {
    color: var(--accent);
    text-decoration: none;
  }
  .ev-station:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .ev-body,
  .ev-rec {
    margin-left: var(--time-w);
  }
  .ev-body {
    line-height: 1.5;
  }
  .ev-what {
    font-size: 15.5px;
    text-wrap: pretty;
  }
  .ev-actor {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 12.5px/1.6 var(--mono);
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0 8px 0 6px;
    vertical-align: 1px;
    white-space: nowrap;
  }
  a.ev-actor:hover,
  a.ev-actor:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .ev-actor,
  .ev-body :global(.achip) {
    margin-right: 8px;
  }
  .ev-rec {
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ev-body,
    .ev-rec {
      margin-left: 0;
    }
  }
</style>
