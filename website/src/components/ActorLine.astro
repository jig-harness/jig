---
// One line of "who runs this station": the actor's chip, then its note or,
// for work not built yet, what the roadmap item builds.
import type { Actor } from "../lib/data/factory.ts";
import ActorChip from "./ActorChip.astro";

interface Props {
  actor: Actor;
}
const { actor } = Astro.props;
const note = actor.kind === "tool" ? actor.note : "note" in actor ? actor.note : undefined;
---

<span class="actor">
  <ActorChip actor={actor} />
  {actor.kind === "todo" && <span class="text">{actor.text}</span>}
  {note && <span class="note">{note}</span>}
</span>

<style>
  .actor {
    display: block;
    font-size: 12.5px;
    line-height: 1.45;
    min-width: 0;
  }
  .text {
    display: block;
    margin-top: 2px;
  }
  .note {
    display: block;
    color: var(--muted);
    margin-top: 2px;
  }
</style>
