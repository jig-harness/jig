---
// Who runs a station, as one mark: a key cap holding the glyph the actor is
// written with (`/` a skill, `@` an agent, `>` a tool), a person's
// silhouette, and a dashed, empty cap for work not built yet. Shape and
// glyph carry the meaning; the mark draws in the text color.
interface Props {
  kind: "skill" | "agent" | "tool" | "person" | "todo";
  size?: number;
}
const { kind, size = 14 } = Astro.props;
const GLYPH: Record<Props["kind"], string> = {
  skill: "/",
  agent: "@",
  tool: ">",
  person: "",
  todo: "",
};
---

{
  kind === "person" ? (
    <svg class="mark person" width={size} height={size} viewBox="0 0 14 14" aria-hidden="true">
      <circle cx="7" cy="4.1" r="2.9" fill="currentColor" />
      <path d="M1.4 13.4c.5-3.6 2.7-5.3 5.6-5.3s5.1 1.7 5.6 5.3z" fill="currentColor" />
    </svg>
  ) : (
    <span class:list={["mark", "cap", kind]} style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.72)}px`} aria-hidden="true">
      {GLYPH[kind]}
    </span>
  )
}

<style>
  .mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    vertical-align: -2px;
  }
  .cap {
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--mono);
    font-weight: 700;
    line-height: 1;
  }
  .todo {
    border-style: dashed;
  }
</style>
