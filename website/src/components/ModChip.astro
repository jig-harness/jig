---
// A module's id as a pill, linking to its page.
interface Props {
  id: string;
  size?: "small" | "normal";
}
const { id, size = "normal" } = Astro.props;
---

<a class:list={["chip", size]} href={`/modules/${id}/`}>{id}</a>

<style>
  .chip {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 10px;
    white-space: nowrap;
  }
  .small {
    font-size: 12px;
    padding: 1px 8px;
  }
  .chip:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
