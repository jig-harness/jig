---
// A module's id as a pill, linking to its page; hovering it opens the
// module's name and the problem it solves (scripts/site.ts).
import { moduleMeta, moduleSummary } from "../lib/data/index.ts";

interface Props {
  id: string;
  size?: "small" | "normal";
}
const { id, size = "normal" } = Astro.props;
const { title } = moduleMeta(id);
---

<a
  class:list={["chip", size]}
  href={`/modules/${id}/`}
  aria-label={`${id} ${title}`}
  data-tip-head={`${id} · ${title}`}
  data-tip-kind="Practice module"
  data-tip-body={moduleSummary(id)}
  data-tip-more="Open the module →">{id}</a
>

<style>
  .chip {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 10px;
    white-space: nowrap;
  }
  .small {
    font-size: 12px;
    padding: 1px 8px;
  }
  .chip:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
