---
// "Your plan": the chosen profile's modules in the order to adopt them,
// each linking to its level, what it leaves for later, and a link that
// hands the plan to whoever will do the work. Every profile's plan is
// rendered; scripts/adopt.ts shows the chosen one.
import { plans } from "../lib/plan.ts";
import LevelGlyph from "./LevelGlyph.astro";
import SkillCommand from "./SkillCommand.astro";

interface Props {
  /** Show step 1's command (the existing-repository guide). */
  audit?: boolean;
  listLabel: string;
  /** The guide's own path, for the hand-off link. */
  path: string;
}
const { audit = false, listLabel, path } = Astro.props;
const all = plans();
---

<aside class="rail" aria-label="Your plan" data-plan-rail>
  <div class="part">
    <span class="head"><span class="label">Your plan</span>{all.map((p, i) => <span class="count" data-for-profile={i} hidden={i !== 0}>{p.countNote}</span>)}</span>
    <div class="pills" role="radiogroup" aria-label="Profile" data-profile-pills>
      {all.map((p, i) => <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-profile={i} data-profile-id={p.id}>{p.name}</button>)}
    </div>
  </div>
  {
    audit && (
      <div class="part">
        <span class="cap">Step 1 · in the repository</span>
        <SkillCommand name="audit" />
      </div>
    )
  }
  <div class="cap list-cap">{listLabel}</div>
  {
    all.map((p, i) => (
      <div data-for-profile={i} hidden={i !== 0}>
        <ol class="order">
          {p.rows.map((r) => (
            <li>
              <span class="pos">{r.pos}</span>
              <span class="id">{r.id}</span>
              <span class="title">
                <span class="name">{r.title}</span>
                {r.when && <span class="when">only if {r.when}</span>}
              </span>
              <a href={`/modules/${r.id}/#${r.level}`}>
                <LevelGlyph rank={r.rank} />
                {r.label}
              </a>
            </li>
          ))}
        </ol>
        <p class="skip">Not targeted, skip until it hurts: {p.skipped.map((s) => s.id).join(", ") || "none"}.</p>
      </div>
    ))
  }
  <div class="handover">
    <span class="eyebrow">Handing over</span>
    <span class="hand-text">Send this to the person who will do the work. The link keeps the profile you picked.</span>
    {
      all.map((p, i) => (
        <span class="hand" data-for-profile={i} hidden={i !== 0}>
          <code title={`https://jig-harness.dev${path}?profile=${p.id}`}>
            <span class="host">jig-harness.dev</span>
            <span>{`${path}?profile=${p.id}`}</span>
          </code>
          <button type="button" class="copy" data-copy data-copy-text={`https://jig-harness.dev${path}?profile=${p.id}`}>Copy handover link</button>
        </span>
      ))
    }
  </div>
</aside>

<style>
  .rail {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 400px;
    position: sticky;
    top: var(--sticky-top);
    max-height: calc(100vh - var(--sticky-top) - 16px);
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
  }
  .part {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  .count {
    font-size: 12.5px;
    color: var(--muted);
  }
  .cap {
    font-size: 13px;
    color: var(--muted);
  }
  .list-cap {
    padding: 12px 16px 4px;
  }
  .order {
    list-style: none;
    margin: 0;
    padding: 0 8px;
  }
  .order li {
    display: grid;
    grid-template-columns: 20px 38px minmax(0, 1fr) auto;
    gap: 6px;
    align-items: center;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    font-size: 13.5px;
    line-height: 1.3;
  }
  .pos {
    font-family: var(--serif);
    font-size: 11.5px;
    color: var(--muted);
  }
  .id {
    font-family: var(--mono);
    font-weight: 600;
  }
  .title {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .when {
    font-size: 12px;
    color: var(--muted);
  }
  .order a {
    display: flex;
    gap: 6px;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .skip {
    margin: 0;
    padding: 8px 16px 14px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .handover {
    background: var(--accent-soft);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hand-text {
    font-size: 14px;
    line-height: 1.45;
  }
  .hand {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .hand code {
    display: flex;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    background: var(--sunk);
    box-shadow: none;
    border-radius: var(--r);
    padding: 8px 10px;
    font-size: 12.5px;
  }
  .host {
    flex: 0 1 auto;
    min-width: 2ch;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--muted);
  }
  .hand code span:last-child {
    flex: 0 0 auto;
  }
  .hand .copy {
    align-self: flex-start;
    padding: 8px 10px;
    min-height: 34px;
  }
  @media (max-width: 1079px) {
    .rail {
      position: static;
      max-width: none;
      max-height: none;
    }
  }
</style>
