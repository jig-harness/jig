---
// Figure 2, every station and who runs it, and the two levels.
import "../../styles/factory.css";
import ActorChip from "../ActorChip.astro";
import DesignRow from "./DesignRow.astro";
import Arrow from "../Arrow.astro";
import ReturnRail from "./ReturnRail.astro";
import ModChip from "../ModChip.astro";
import SectionHead from "../SectionHead.astro";
import StationBox from "../StationBox.astro";
import StatusMark from "../StatusMark.astro";
import { HANDOFFS } from "../../lib/data/factory.ts";
import Matrix from "./Matrix.astro";
import { factory } from "../../lib/data/index.ts";
import { mdInline } from "../../lib/markdown.ts";
const f = factory();
const inline = (text: string, from = "FACTORY.md") => mdInline(text, from);
const handoff = (id: string) => HANDOFFS[id]?.label;
const levelRows = await Promise.all(
  f.levels.map(async (l) => ({
    ...l,
    unitHtml: await inline(l.unit),
    decidesHtml: await inline(l.decides),
    handsHtml: await inline(l.handsOn),
  })),
);
---

  <SectionHead id="levels" label="Two levels and a loop around them" note="the stations, on that scaffolding" />
  <p class="lead" set:html={await inline(f.levelsLead)} />
  <figure class="detail" aria-labelledby="fx-cap">
    <div class="legend" role="list" aria-label="Who runs a station">
      <span role="listitem"><StatusMark kind="skill" size={13} />a skill</span>
      <span role="listitem"><StatusMark kind="agent" size={13} />an agent, called by skills</span>
      <span role="listitem"><StatusMark kind="tool" size={13} />a tool, outside the agent</span>
      <span role="listitem"><StatusMark kind="person" size={13} />a person</span>
      <span role="listitem"><StatusMark kind="todo" size={13} />not built yet · its roadmap item</span>
      <span role="listitem" class="muted">hover any chip for what it does</span>
    </div>
    <div class="loop-frame">
      <a class="frame-tag" href="/factory/learning-loop/">↻ Learning loop · M8 · wraps both levels</a>
      <span class="frame-tag orbit-note" aria-hidden="true">a miss at any station ↗ becomes a check ↙</span>
      <div class="level-head" id="design-level">
        <span><span class="label">A · Design and planning</span> <span class="muted">a feature or an epic · the feature pipeline</span></span>
        <span class="chips">{f.levels[0]?.modules.map((id) => <ModChip id={id} size="small" />)}</span>
      </div>
      <DesignRow />
      <div class="handoff"><Arrow dir="down" class="handoff-arrow" /><span>hands on an epic of planned work items · each sub-issue enters the line below as one work item</span></div>
      <div class="level-head" id="execution-level">
        <span><span class="label">B · Execution</span> <span class="muted">one work item · the work-item line</span></span>
        <span class="chips">{f.levels[1]?.modules.map((id) => <ModChip id={id} size="small" />)}</span>
      </div>
      <ol class="row seven">
        {f.line.map((s, i) => <StationBox station={s} arrow={i < f.line.length - 1} handoff={handoff(s.id)} />)}
      </ol>
      <ReturnRail>↺ follow-up items enter the line again at station 1 · no skill merges</ReturnRail>
      <div class="base">
        <span class="base-item"><span class="frame-tag inline">↺ misses → lenses</span><span class="base-text">every miss becomes a new check; <ActorChip actor={{ kind: "skill", name: "reflect" }} /> records what a session learned, <ActorChip actor={{ kind: "skill", name: "review-reflections" }} /> turns it into changes a person approves, <ActorChip actor={{ kind: "skill", name: "promote-memory" }} /> promotes session memory</span></span>
        <span class="base-item"><span class="audit-tag">Audit</span><span class="base-text"><ActorChip actor={{ kind: "skill", name: "audit" }} /> inspects the factory itself: scores every module and, re-run, reports what drifted</span></span>
      </div>
    </div>
    <figcaption id="fx-cap">
      Figure 2: the stations in detail. Two levels inside the learning loop; every station names what runs it and what it hands on, and unbuilt work stays in the figure with its roadmap item. The tinted station is a person's decision. Every station here stands on the scaffolding in <a href="#figure-1">figure 1</a>; <a href="/factory/design/">level A</a> and <a href="/factory/execution/">level B</a> each have a page.
    </figcaption>
  </figure>

  <Matrix />

  <div class="levels-table">
    <div class="th" aria-hidden="true"><span>Level</span><span>Unit of work</span><span>What it decides</span><span>What it hands on</span><span>Modules</span></div>
    {
      levelRows.map((l) => (
        <div class="level-row">
          <span class="job-name">{l.name}</span>
          <span set:html={l.unitHtml} />
          <span set:html={l.decidesHtml} />
          <span set:html={l.handsHtml} />
          <span class="chips">
            {l.modules.map((id) => (
              <ModChip id={id} size="small" />
            ))}
          </span>
        </div>
      ))
    }
  </div>
  <p class="small-p" set:html={await inline(f.loopAndAudit)} />
