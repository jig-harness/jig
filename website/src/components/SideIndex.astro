---
// A sticky list of a page family's members (the skills, the principles),
// with the current one held. On a phone it folds into one line above the
// page.
interface Item {
  label: string;
  href: string;
  num?: string;
  current?: boolean;
}
interface Props {
  title: string;
  items: Item[];
}
const { title, items } = Astro.props;
const current = items.find((i) => i.current);
---

<nav class="side" aria-label={title}>
  <details open class="wide-open">
    <summary>
      <span class="label">{title}</span>
      {current && <span class="cur">{current.num ? `${current.num} · ` : ""}{current.label}</span>}
    </summary>
    <ol>
      {
        items.map((i) => (
          <li>
            <a href={i.href} aria-current={i.current ? "page" : undefined}>
              {i.num && <span class="num">{i.num}</span>}
              <span>{i.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<script>
  // On a phone the index starts folded; on a wide screen it stays open, with
  // the current page scrolled into the part of a long list that shows. A
  // window resized across the breakpoint folds or opens it again.
  const narrow = window.matchMedia("(max-width: 1079px)");
  const fit = () => {
    for (const side of document.querySelectorAll<HTMLElement>(".side")) {
      const details = side.querySelector("details");
      if (details) details.open = !narrow.matches;
      if (narrow.matches) continue;
      const here = side.querySelector<HTMLElement>("a[aria-current='page']");
      if (here && here.offsetTop + here.offsetHeight > side.clientHeight)
        side.scrollTop = here.offsetTop - (side.clientHeight - here.offsetHeight) / 2;
    }
  };
  narrow.addEventListener("change", fit);
  fit();

  // An index of in-page anchors marks the section being read: the last one
  // whose top has risen into the upper third of the screen, or to where an
  // anchor jump lands it (the root's scroll padding plus its own scroll
  // margin) when that is lower, as in a short window; or the last of all once
  // the page is scrolled to its foot.
  for (const side of document.querySelectorAll<HTMLElement>(".side")) {
    const links = [...side.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const sections = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    if (links.length === 0 || links.length !== side.querySelectorAll("a").length || sections.includes(null)) continue;
    let marked: HTMLAnchorElement | undefined;
    let queued = false;
    const mark = () => {
      queued = false;
      const atFoot = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      const third = window.innerHeight / 3;
      const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const line = (s: HTMLElement) => Math.max(third, padding + (parseFloat(getComputedStyle(s).scrollMarginTop) || 0) + 1);
      let at = atFoot ? sections.length - 1 : -1;
      if (!atFoot) sections.forEach((s, i) => s && s.getBoundingClientRect().top <= line(s) && (at = i));
      const next = links[at];
      if (next === marked) return;
      marked?.removeAttribute("aria-current");
      next?.setAttribute("aria-current", "location");
      marked = next;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(mark);
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    mark();
  }
</script>

<style>
  .side {
    flex: 0 1 260px;
    max-width: 300px;
    min-width: 0;
    position: sticky;
    top: var(--sticky-top);
    align-self: flex-start;
    /* A list longer than the window scrolls within it. */
    max-height: calc(100vh - var(--sticky-top) - 16px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
    pointer-events: none;
  }
  .cur {
    display: none;
    font-size: 13px;
    color: var(--muted);
  }
  ol {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    padding: 7px 8px;
    text-decoration: none;
    font-size: 14.5px;
    color: var(--ink);
  }
  a:hover {
    background: var(--sunk);
  }
  a[aria-current="page"] {
    background: var(--accent-soft);
    font-weight: 600;
  }
  /* The section in view: quieter than the page you are on. */
  a[aria-current="location"] {
    background: var(--sunk);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  @media (max-width: 1079px) {
    .side {
      position: static;
      flex: 1 1 100%;
      max-width: none;
      max-height: none;
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      background: var(--card);
      padding: 10px 14px;
    }
    summary {
      pointer-events: auto;
      min-height: 32px;
      align-items: center;
    }
    .cur {
      display: inline;
    }
  }
</style>
