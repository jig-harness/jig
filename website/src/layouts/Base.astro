---
import "../styles/global.css";
import GithubMark from "../components/GithubMark.astro";
import Logo from "../components/Logo.astro";
import { glossary } from "../lib/data/index.ts";
import { REPO_URL } from "../lib/routes.ts";
import { currentRelease, NAV } from "../lib/site.ts";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Delivery practices for teams that build and maintain software with AI coding agents.",
} = Astro.props;
const release = currentRelease();
const released = release.date
  ? new Date(`${release.date}T12:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
    })
  : "";
const here = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href);
// A section with pages of its own shows them in a bar under the header on
// each of its pages, so the reader always sees where they are among them.
const section = NAV.find((n) => n.pages && current(n.href));
const atPage = (href: string) => here.replace(/\/?$/, "/") === href;
const repoName = new URL(REPO_URL).pathname.slice(1);
const termCount = glossary().length;
const pageTitle = title === "Jig" ? "Jig Harness — delivery practices for teams building with AI coding agents" : `${title} · Jig Harness`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script is:inline>
      // The reader's theme choice, applied before the page paints.
      try {
        const t = localStorage.getItem("jig-theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="bar wrap">
        <a class="home" href="/" aria-label="Jig home"><Logo /></a>
        <nav class="nav wide-only" aria-label="Site">
          {
            NAV.map((n) =>
              n.pages ? (
                <div class="nav-item">
                  <a href={n.href} class="has-sub" aria-current={current(n.href) ? "page" : undefined}>
                    {n.label}
                  </a>
                  <div class="nav-sub">
                    {n.pages.map((p) => (
                      <a href={p.href} aria-current={atPage(p.href) ? "page" : undefined}>
                        {p.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={n.href} aria-current={current(n.href) ? "page" : undefined}>
                  {n.label}
                </a>
              ),
            )
          }
        </nav>
        <span class="spacer narrow-only"></span>
        <button type="button" class="theme" data-theme-switch aria-label="Theme: your system's">
          <svg class="theme-icon theme-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
          </svg>
          <svg class="theme-icon theme-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
        </button>
        <div class="search" role="search" data-search hidden>
          <label class="search-field">
            <span class="vh">Search the site</span>
            <input
              type="search"
              placeholder={`Search modules, skills, ${termCount} terms`}
              autocomplete="off"
              aria-controls="search-results"
              aria-expanded="false"
              data-search-input
            />
            <kbd title="Press / to search">/</kbd>
          </label>
          <div id="search-results" class="search-results" role="listbox" hidden data-search-results></div>
        </div>
        <a class="repo" href={REPO_URL} aria-label="Jig on GitHub">
          <GithubMark /><span class="repo-name wide-only">{repoName}</span>
        </a>
        <details class="menu narrow-only">
          <summary>Menu</summary>
          <nav aria-label="Site">
            <a href="/">Overview</a>
            {NAV.map((n) => <a href={n.href} aria-current={current(n.href) ? "page" : undefined}>{n.label}</a>)}
          </nav>
        </details>
      </div>
      {
        section?.pages && (
          <nav class="section-bar" aria-label={`${section.label} pages`}>
            <div class="section-row wrap">
              {section.pages.map((p) => (
                <a href={p.href} aria-current={atPage(p.href) ? "page" : undefined}>
                  {p.label}
                </a>
              ))}
            </div>
          </nav>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <div class="foot-id">
        <img src="/brand/jig-guide-light.svg" alt="" width="52" height="52" />
        <span>
          Delivery practices for teams that build and maintain software with AI
          coding agents. Distilled from a production codebase built with AI
          agents.
        </span>
      </div>
      <div class="foot-links">
        <a href="/features/">What you get</a>
        <a href="/factory/">Jig as a software factory</a>
        <a href="/adopt/">Getting started</a>
        <a href="/adopt/existing/">Adoption guide</a>
        <a href="/adopt/greenfield/">Greenfield guide</a>
      </div>
      <div class="foot-links">
        <a href="/modules/">Modules</a>
        <a href="/skills/">Skills</a>
        <a href="/principles/">Principles</a>
        <a href="/glossary/">Glossary</a>
      </div>
      <div class="foot-links">
        <a class="foot-version" href="/whats-new/">plugin v{release.version} · {released} · what's new</a>
        <a class="foot-repo" href={REPO_URL}><GithubMark />{repoName}</a>
        <span class="muted">Created by Ophir Radnitz.</span>
        <span class="muted">The pages are built from the repository's own documents.</span>
        <span class="muted">
          Licensed under the <a href={`${REPO_URL}/blob/main/LICENSE`}>Apache License 2.0</a>;
          template files under <a href={`${REPO_URL}/blob/main/LICENSE-MIT-0`}>MIT No Attribution</a>.
        </span>
      </div>
    </footer>

    <div class="tip" role="tooltip" id="term-tip" hidden data-tip></div>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 50;
    background: var(--card);
    padding: 6px 10px;
    border-radius: var(--r);
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 62px;
  }
  .home {
    display: block;
    flex: none;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 2px;
    flex: 1 1 auto;
    flex-wrap: wrap;
  }
  .nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    padding: 6px 9px;
    border-radius: var(--r);
    color: var(--ink);
    white-space: nowrap;
  }
  .nav a:hover {
    background: var(--sunk);
  }
  .nav a[aria-current="page"] {
    font-weight: 600;
    border-radius: 0;
    background: transparent;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  /* A section's pages open under its entry on hover or keyboard focus;
     Escape closes them (site.ts). */
  .nav-item {
    position: relative;
    display: flex;
  }
  .has-sub::after {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 1px 3px 7px;
    border: solid var(--muted);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .nav-sub {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 30;
    min-width: 230px;
    padding: 6px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: 0 10px 30px var(--shadow);
  }
  /* A bridge over the gap below the entry, so the pointer can cross it. */
  .nav-sub::before {
    content: "";
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .nav-item:not(.dismissed):hover .nav-sub,
  .nav-item:not(.dismissed):focus-within .nav-sub {
    display: grid;
  }
  .nav .nav-sub a {
    font-size: 14.5px;
    padding: 8px 10px;
    border-radius: var(--r);
  }
  .nav .nav-sub a[aria-current="page"] {
    box-shadow: none;
    background: var(--accent-soft);
    border-radius: var(--r);
  }

  /* The section's pages, held under the header as the reader scrolls. */
  .section-bar {
    border-top: 1px solid var(--line);
    background: var(--sunk);
  }
  .section-row {
    position: relative;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .section-bar a {
    flex: none;
    text-decoration: none;
    font-weight: 500;
    font-size: 14.5px;
    padding: 10px 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .section-bar a:first-child {
    margin-left: -12px;
  }
  .section-bar a:hover {
    color: var(--ink);
  }
  .section-bar a[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .spacer {
    flex: 1;
  }

  .theme {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 999px;
    width: 38px;
    height: 38px;
    padding: 0;
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--line-strong);
    background: var(--card);
  }
  /* The icon names the theme in effect: the system's until the reader picks. */
  .theme-icon {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-moon,
  :global([data-theme="dark"]) .theme-sun {
    display: none;
  }
  :global([data-theme="dark"]) .theme-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .theme-moon {
      display: block;
    }
  }

  .search {
    position: relative;
    width: clamp(200px, 18vw, 300px);
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    background: var(--card);
    padding: 0 6px 0 10px;
    min-height: 38px;
  }
  .search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font: 15px var(--sans);
    color: var(--ink);
    padding: 7px 0;
  }
  .search-field input:focus {
    outline: none;
  }
  .search-field:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .search-field kbd {
    font: 500 11.5px var(--mono);
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    padding: 1px 6px;
    color: var(--muted);
  }
  .search-results {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: min(480px, 92vw);
    z-index: 40;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: 0 10px 30px var(--shadow);
    overflow: hidden;
  }

  .repo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 4px 2px;
    white-space: nowrap;
    min-height: var(--tap);
  }
  .repo:hover {
    color: var(--accent-hover);
  }

  .menu summary {
    font: 600 14px var(--sans);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    padding: 10px 14px;
    min-height: var(--tap);
    display: flex;
    align-items: center;
  }
  .menu summary:hover {
    background: var(--accent-hover);
  }
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: grid;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 6px var(--gutter) 14px;
  }
  .menu nav a {
    text-decoration: none;
    font-size: 17px;
    font-weight: 500;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
  }
  .menu nav a[aria-current="page"] {
    color: var(--accent);
  }

  .foot {
    background: var(--sunk);
    border-top: 1px solid var(--line);
    padding-block: 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 24px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .foot-id {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .foot-id img {
    flex: none;
  }
  .foot-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .foot-version {
    font-size: 13px;
    color: var(--accent);
  }
  .foot-repo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .narrow-only {
    display: none;
  }
  /* Below a wide window the repository is its mark alone, so the site's
     links keep to one row. */
  @media (max-width: 1199px) {
    .repo-name {
      display: none;
    }
  }
  @media (max-width: 1079px) {
    .wide-only {
      display: none;
    }
    .narrow-only {
      display: revert;
    }
    span.spacer.narrow-only {
      display: block;
    }
    .theme {
      width: var(--tap);
      height: var(--tap);
      padding: 0;
      border: 0;
    }
    .search {
      display: none;
    }
  }
</style>
