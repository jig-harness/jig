---
import AuditSpecimen from "../components/AuditSpecimen.astro";
import CrossSection from "../components/CrossSection.astro";
import Ladder from "../components/Ladder.astro";
import LevelGlyph from "../components/LevelGlyph.astro";
import ModuleMap from "../components/ModuleMap.astro";
import Plate from "../components/Plate.astro";
import JigModel from "../components/JigModel.astro";
import SkillCommand from "../components/SkillCommand.astro";
import Base from "../layouts/Base.astro";
import { modules, profiles, readme } from "../lib/data/index.ts";
import { LEVEL_NAME } from "../lib/data/modules.ts";
import { mdInline } from "../lib/markdown.ts";
import type { PlateName } from "../lib/plates.ts";
import { countWord } from "../lib/view.ts";

const count = modules().length;
const r = readme();
const allProfiles = profiles().profiles;
const solo = allProfiles.find((p) => p.id === "solo-lite");
if (!solo) throw new Error("profiles.yaml has no solo-lite profile");
const soloCount = Object.keys(solo.targets).length;
const levelNames = Object.values(LEVEL_NAME);
const fxLead = await mdInline(r.factory.lead, "README.md");
const fxJobs = await Promise.all(
  r.factory.jobs.map(async (j) => ({ lead: j.lead, html: await mdInline(j.body, "README.md") })),
);
const fxFits = await mdInline(r.factory.fits, "README.md");
const fxStations = await mdInline(r.factory.stations, "README.md");

// The plate beside each way of using Jig, by the way's number in the README:
// a stencil set for the template, the wrench rack for the upgrade one module
// at a time, the card catalog for the pattern looked up, the tool wall for
// the tooling every repository shares.
const WAY_PLATES: readonly PlateName[] = ["stencils", "wrenches", "catalog", "toolwall"];
const ways = await Promise.all(
  r.ways.map(async (w, i) => {
    const plate = WAY_PLATES[i];
    if (!plate) throw new Error(`the README names more ways to use Jig than the home page has plates for (${w.lead})`);
    const body = w.body.replace(/^\*\*[^*]+\*\*\s*[—–-]\s*/, "");
    return {
      n: w.n,
      lead: w.lead,
      plate,
      html: await mdInline(body.charAt(0).toUpperCase() + body.slice(1), "README.md"),
    };
  }),
);
const profileCards = allProfiles.map((p, i) => ({
  id: p.id,
  name: p.name,
  rank: i + 1,
  question: p.question,
  summary:
    `${Object.keys(p.targets).length} modules targeted` +
    (Object.keys(p.conditional).length ? `, ${Object.keys(p.conditional).length} conditional` : ""),
}));

// Site-owned copy: what the home page says in its own words. Each limit
// points at the document that states it.
const LIMITS = [
  { text: "A person merges. No skill merges or approves a pull request.", src: "M7 invariant · drive-pr", href: "/skills/drive-pr/" },
  { text: "Nothing an audit recommends is applied by itself: your team marks each choice and hands the decisions to an agent.", src: "the audit experience", href: "#day-one" },
  { text: "Changes an agent proposes to its own rules wait for a human to approve them.", src: "principle 5 · M8", href: "/principles/5/" },
  { text: "Promotion to production is a manual, gated human action that cannot auto-fire.", src: "M10 invariant", href: "/modules/M10/" },
  { text: "An automated reviewer blocks nothing until its measured precision clears a bar set in advance.", src: "M7 invariant", href: "/modules/M7/" },
];
---

<Base title="Jig">
  <section class="hero wrap">
    <span class="label">Delivery practices for teams that build with AI coding agents</span>
    <h1 class="display">Scaffolding that lets AI agents work your repository well — adopted one module at a time.</h1>
    <p class="lede">
      Jig is a modular collection of software-delivery practices for teams that build and maintain software with AI
      coding agents. A jig, in a workshop, holds the work and guides the tool so every cut comes out the same; Jig's
      skills and gates do that for agents.
    </p>
    <p class="sub">
      You don't adopt all of it: <a href="#map">{count} independent modules</a>, each at three levels. A one-person
      project starts with {countWord(soloCount)} modules at Lite. Every practice is a tool-independent rule first, mapped to your tools
      second.
    </p>
    <span class="hero-plate"><JigModel /></span>
    <div class="paths">
      <div class="path">
        <span class="label">Evaluating Jig for a team</span>
        <p>Ten minutes: what it is, what it never does, and how far a team like yours should go.</p>
        <div class="path-links">
          <a href="/features/">What you get: the skills, gates and loops, and what runs each →</a>
          <a href="#factory">Jig as a software factory: what it runs on, and who runs each station ↓</a>
          <a href="#limits">What Jig never does ↓</a>
          <a href="/adopt/">Choose how far to go: {countWord(allProfiles.length)} profiles →</a>
        </div>
      </div>
      <div class="path lit">
        <span class="eyebrow">Working on a repository</span>
        <p>Start with an audit. It scores your repository against every module and says what to do first.</p>
        <SkillCommand name="audit" />
        <div class="path-links">
          <a href="/plugin/">Install the plugin →</a>
          <a href="/adopt/">The adoption guide →</a>
          <a href="/modules/">Find a module →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="factory" class="factory wrap band" aria-labelledby="factory-h">
    <div class="fx-text">
      <span class="eyebrow">Jig as a software factory</span>
      <h2 id="factory-h" class="display">A factory of agents runs on scaffolding.</h2>
      <p set:html={fxLead} />
      <ul class="fx-jobs">
        {fxJobs.map((j) => <li><a class="label" href={`/factory/scaffolding/#job-${j.lead.toLowerCase()}`}>{j.lead}</a><span set:html={j.html} /></li>)}
      </ul>
      <p set:html={fxFits} />
      <p class="muted small" set:html={fxStations} />
      <a class="more" href="/factory/">What the factory runs on, every station, and what is on the roadmap →</a>
    </div>
    <CrossSection variant="mini" />
  </section>

  <section id="map" class="map-strip wrap band" aria-labelledby="map-h">
    <div class="map-text">
      <span class="eyebrow">The map</span>
      <h2 id="map-h" class="display small-h">All of Jig, and how much of it you need.</h2>
      <p>
        Jig is {count} modules, one per practice; an adopted module can reach one of three levels:{" "}
        {levelNames.join(", ")}. The map shows every module at every level; pick a profile and the cells it fills are
        the levels a team like yours aims for. The rest is there when the answer changes.
      </p>
      <p class="muted small">
        A one-person project fills {countWord(soloCount)} cells. Nobody fills them all: a module you don't need is
        a row you skip.
      </p>
      <a class="more" href="/modules/">The full map: every level named, and the skills that run each module →</a>
    </div>
    <figure class="map-card">
      <ModuleMap variant="compact" />
    </figure>
  </section>

  <section id="limits" class="limits wrap band band-sunk">
    <div class="split">
      <div class="limits-head">
        <span class="eyebrow">The limits</span>
        <h2 class="display">What Jig never does. A person stays on the decisions that matter.</h2>
      </div>
      <ul class="limit-list">
        {
          LIMITS.map((l) => (
            <li>
              <span class="sq" aria-hidden="true" />
              <span class="limit">
                <span class="limit-text">{l.text}</span>
                <a class="limit-src" href={l.href}>{l.src}</a>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ladder wrap band">
    <div class="ladder-text">
      <span class="eyebrow">The idea under every module</span>
      <h2 class="display small-h">Every rule names how hard it is to skip.</h2>
      <p>
        A rule can live anywhere from a sentence in a doc to a check that blocks the merge. Jig asks each rule where it
        lives today and what would promote it. The audit scores exactly that, so "we always do X" and "something fails
        if we don't" stop looking the same.
      </p>
      <a class="more" href="/principles/4/">Principle 4 — Enforcement-ladder discipline →</a>
    </div>
    <Ladder caption="The enforcement ladder, from principle 4. Local hooks are conveniences; CI is the authority." />
  </section>

  <section class="profiles wrap band">
    <div class="profiles-head">
      <div>
        <span class="eyebrow">How far to go</span>
        <h2 class="display small-h">{countWord(allProfiles.length, true)} profiles. Answer one question.</h2>
      </div>
      <a class="more" href="/adopt/">Compare what each one asks →</a>
    </div>
    <div class="cards">
      {
        profileCards.map((p) => (
          <a class="card" href={`/adopt/?profile=${p.id}`}>
            <span class="card-name">
              <LevelGlyph rank={p.rank} />
              {p.name}
            </span>
            <span class="card-q">{p.question}</span>
            <span class="card-sum">{p.summary}</span>
          </a>
        ))
      }
    </div>
    <p class="muted">Graduate when the answer changes — profiles are stages, not identities.</p>
  </section>

  <section id="day-one" class="day wrap band">
    <div class="day-head">
      <div>
        <span class="eyebrow">Day one</span>
        <h2 class="display small-h">What you get first: an audit sheet of where you stand.</h2>
      </div>
      <p>
        The <code>jig:audit</code> skill scores your repository against every module's criteria and renders one self-contained HTML
        page. Nothing is applied: you mark each recommendation, copy your decisions, and hand them to an agent as one block
        of text. Below is a real one, from a run on an open-source library.
      </p>
    </div>
    <AuditSpecimen />
  </section>

  <section class="ways wrap band" aria-labelledby="ways-h">
    <div class="ways-head">
      <span class="eyebrow">{countWord(ways.length, true)} ways to use it</span>
      <h2 id="ways-h" class="display small-h">A template, an upgrade path, a reference, or tooling you never copy.</h2>
    </div>
    <ol class="way-cards">
      {
        ways.map((w) => (
          <li class="way">
            <span class="way-plate"><Plate name={w.plate} width="auto" tone={0.78} /></span>
            <span class="way-title"><span class="num">{w.n}</span>{w.lead}</span>
            <span class="way-body" set:html={w.html} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="close wrap band" aria-labelledby="close-h">
    <div class="close-text">
      <span class="eyebrow">Where to start</span>
      <h2 id="close-h" class="display">One command, then one module at a time.</h2>
      <p>
        Install the plugin, run the audit, read the sheet. Nothing in your repository changes until you choose what
        to adopt first, and the profile you pick says how far to take it.
      </p>
      <SkillCommand name="audit" />
      <div class="close-links">
        <a href="/plugin/">Install the plugin →</a>
        <a href="/adopt/">The adoption guide →</a>
        <a href="/principles/">The principles behind every module →</a>
      </div>
    </div>
    <span class="close-plate"><Plate name="slab" tone={0.7} /></span>
  </section>
</Base>

<style>
  /* The hero: the statement and the two reader paths on the left; the jig
     on the right, filling the rest of the window to a margin, closed by the
     first --seq-len of scrolling and swivelled by the pointer. Below 1000px
     it stands between the statement and the paths, at the column's width. */
  .hero {
    --seq-len: 55vh;
    position: relative;
    padding-top: clamp(24px, 3.4vw, 48px);
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    overflow-x: clip;
  }
  .hero > * {
    min-width: 0;
  }
  .hero h1 {
    font-size: clamp(34px, 3.9vw, 58px);
    line-height: 1.04;
    max-width: 17ch;
  }
  .lede {
    margin: 0;
    max-width: 60ch;
  }
  .hero-plate {
    display: block;
    width: min(130%, 640px);
    justify-self: center;
    pointer-events: none;
  }
  @media (width > 1000px) {
    .hero {
      grid-template-columns: minmax(0, 58%) minmax(0, 1fr);
      min-height: clamp(520px, 50vw, 760px);
      align-content: center;
    }
    .hero > * {
      grid-column: 1;
    }
    .hero-plate {
      --figure-w: min(46vw, 760px);
      position: absolute;
      top: 48%;
      right: calc(var(--gutter) * 0.5 - 20px);
      width: var(--figure-w);
      translate: 0 -50%;
      justify-self: auto;
    }
    /* Taller than wide: the handle swings low as the jig turns, and the
       bit stands high while it is open. */
    .hero-plate :global(.jig-model) {
      aspect-ratio: 0.9;
    }
  }
  .sub {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    max-width: 60ch;
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 14px;
  }
  .path {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .path.lit {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
  }
  .path p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.5;
  }
  .path-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 500;
    font-size: 15px;
    margin-top: auto;
  }

  .factory {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .fx-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .fx-text p {
    margin: 0;
    max-width: 58ch;
    text-wrap: pretty;
  }
  .small {
    font-size: 15px;
  }
  .fx-jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .fx-jobs li {
    display: grid;
    grid-template-columns: minmax(96px, auto) minmax(0, 1fr);
    gap: 4px 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    font-size: 15.5px;
    line-height: 1.5;
  }
  .more {
    font-weight: 500;
  }

  /* The map strip: what the map means on the left, the map on the right. */
  .map-strip {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .map-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    position: sticky;
    top: 24px;
  }
  .map-text p {
    margin: 0;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .map-card {
    margin: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 18px 18px 14px;
    min-width: 0;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(24px, 4vw, 56px);
  }
  .limits-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .limit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .limit-list li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 14px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
  }
  .sq {
    width: 10px;
    height: 10px;
    background: var(--accent);
    margin-top: 8px;
    border-radius: 2px;
  }
  .limit {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .limit-text {
    font-size: 17px;
    line-height: 1.45;
  }
  .limit-src {
    color: var(--muted);
    font-size: 12px;
    text-decoration-color: var(--muted);
  }
  .limit-src:hover {
    color: var(--accent-hover);
  }

  .ladder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(28px, 4vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  .ladder-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ladder-text p {
    margin: 0;
    max-width: 56ch;
    text-wrap: pretty;
  }
  .small-h {
    font-size: clamp(24px, 2.3vw, 34px);
    line-height: 1.15;
  }
  .profiles {
    border-bottom: 1px solid var(--line);
  }
  .profiles-head,
  .day-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .profiles-head > div,
  .day-head > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px;
  }
  .card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
    color: var(--ink);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 18px;
  }
  .card-q {
    font-size: 15.5px;
    line-height: 1.45;
  }
  .card-sum {
    font-size: 12px;
    color: var(--muted);
    margin-top: auto;
  }
  .profiles > p {
    margin: 14px 0 0;
    font-size: 15px;
  }
  .day {
    border-bottom: 1px solid var(--line);
  }
  .day-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 14px clamp(28px, 4vw, 64px);
  }
  .day-head p {
    margin: 0;
    max-width: 60ch;
    text-wrap: pretty;
  }

  /* The ways: one card per way, its plate above its name. */
  .ways-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 26px;
  }
  .ways-head h2 {
    max-width: 30ch;
  }
  .way-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 14px;
  }
  .way {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
  }
  .way-plate {
    display: grid;
    place-items: center;
    height: 150px;
    padding: 4px 18px;
    margin-bottom: 6px;
  }
  .way-plate :global(.plate) {
    height: 100%;
  }
  .way-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 600;
    font-size: 18px;
  }
  .way-title .num {
    font: 600 13px var(--mono);
    color: var(--accent);
  }
  .way-body {
    font-size: 15px;
    line-height: 1.5;
  }

  /* The close: where to start, with the foundation plate rising from the
     page's lower edge behind it, feathered on its upper and left edges and
     cut by the footer, so the page stands on it. */
  .close {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--line);
    padding-bottom: clamp(120px, 14vw, 200px);
  }
  .close-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 56ch;
  }
  .close-text p {
    margin: 0;
    text-wrap: pretty;
  }
  .close :global(.cmd) {
    max-width: 320px;
  }
  .close-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-weight: 500;
    font-size: 15px;
  }
  .close-plate {
    --bleed-w: min(72vw, 1180px);
    position: absolute;
    right: calc(-1 * var(--gutter) - 0.06 * var(--bleed-w));
    bottom: calc(-0.2 * var(--bleed-w) * 0.56);
    width: var(--bleed-w);
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(to right, transparent 4%, #000 42%, #000 100%), linear-gradient(to bottom, transparent 4%, #000 44%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 4%, #000 42%, #000 100%), linear-gradient(to bottom, transparent 4%, #000 44%);
    mask-composite: intersect;
  }
  @media (max-width: 1000px) {
    .close-plate {
      --bleed-w: 120vw;
      right: -20vw;
      opacity: 0.6;
    }
  }
</style>
