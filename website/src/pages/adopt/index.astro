---
import AuditSpecimen from "../../components/AuditSpecimen.astro";
import SideIndex from "../../components/SideIndex.astro";
import SkillCommand from "../../components/SkillCommand.astro";
import Base from "../../layouts/Base.astro";
import { md } from "../../lib/markdown.ts";
import { START_SECTIONS } from "../../lib/plugin-guide.ts";
import { REPO_URL } from "../../lib/routes.ts";
import { read } from "../../lib/site.ts";
import { sections } from "../../lib/source.ts";
import { headingId } from "../../lib/view.ts";

const FROM = "plugin/README.md";
const parts = sections(read(FROM));
const take = (title: string) => parts.find((p) => p.title === title)?.body ?? "";
const demote = (body: string) => body.replace(/^### /gm, "#### ");
const [agentSource, ...stationSources] = START_SECTIONS;
const agentHtml = await md(take(agentSource), FROM);
// The stations from nothing installed to a first audit, each a section of
// the plugin's README; the last, the audit itself, is this page's own.
const TITLES: Record<string, string> = {
  Requirements: "What you need",
  "Install the plugin": "Install once per machine",
  "Use a skill": "Use a skill",
  "Configure a repository": "Configure the repository",
};
const stations = await Promise.all(
  stationSources.map(async (source, i) => ({
    source,
    title: TITLES[source] ?? source,
    id: `st-${i + 1}`,
    html: await md(demote(take(source)), FROM),
  })),
);
const auditStation = `st-${stations.length + 1}`;
---

<Base title="Get started with Jig" description="Hand the setup to your agent, or do it yourself: from nothing installed to your first audit, then the guide for your repository.">
  <section class="page wrap with-side">
    <SideIndex
      title="Getting started"
      items={[
        { label: "Hand it to your agent", href: `#${headingId(agentSource)}` },
        ...stations.map((s, i) => ({ label: s.title, href: `#${s.id}`, num: String(i + 1) })),
        { label: "Run your first audit", href: `#${auditStation}`, num: String(stations.length + 1) },
        { label: "Then follow your guide", href: "#guides" },
      ]}
    />
    <article class="main">
      <span class="eyebrow">Adopt Jig · getting started</span>
      <h1 class="display">From nothing installed to your first audit.</h1>
      <p class="lede-p">
        To adopt Jig, install the jig plugin once on your machine, run its audit on your repository, then follow the
        guide for an existing repository or a new project, one module at a time. The audit writes one file, its record
        <code>.config/jig-audit.yaml</code>; nothing else in your repository changes until you choose what to adopt.
      </p>

      <section class="agent" id={headingId(agentSource)}>
        <span class="eyebrow">The quick way</span>
        <h2>Hand it to your agent</h2>
        <div class="prose" set:html={agentHtml} />
      </section>

      <h2 class="yourself">Or do it yourself</h2>
      {
        stations.map((s, i) => (
          <section class="station" id={s.id}>
            <span class="anchor" id={headingId(s.source)} />
            <h3><span class="num">{i + 1}</span>{" "}{s.title}</h3>
            <div class="prose" set:html={s.html} />
          </section>
        ))
      }
      <section class="station" id={auditStation}>
        <h3><span class="num">{stations.length + 1}</span>{" "}Run your first audit</h3>
        <p>In the repository, start a session and run:</p>
        <SkillCommand name="audit" />
        <p>On a first audit it asks which profile you aim for. What you will see is a sheet like this one, a real run on an open-source library:</p>
        <AuditSpecimen compact />
      </section>

      <section class="guides" id="guides">
        <h2>Then follow your guide</h2>
        <p>The sheet ranks what to adopt first. The guide for your kind of repository says how far to take it.</p>
        <div class="cards">
          <a class="card" href="/adopt/existing/">
            <span class="card-name">Existing repository →</span>
            <span>Choose a profile, then climb one rung at a time, in the order the audit ranks.</span>
          </a>
          <a class="card" href="/adopt/greenfield/">
            <span class="card-name">New project →</span>
            <span>Run the kickoff, each phase handing over to the module that governs it.</span>
          </a>
        </div>
      </section>
      <p class="source"><a class="out" href={`${REPO_URL}/blob/main/${FROM}`}>Source: {FROM}</a> · <a href="/adopt/plugin/">The rest of the plugin guide</a> · <a href="/adopt/configuration/">Every configuration field</a></p>
    </article>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(30px, 3.2vw, 46px);
    margin: 12px 0 16px;
  }
  .lede-p {
    margin: 0;
    max-width: 70ch;
    font-size: 18px;
  }
  .anchor {
    display: block;
  }
  .agent {
    margin-top: 28px;
    padding: 18px 20px;
    background: var(--accent-soft);
    border-radius: var(--r-card);
  }
  .agent h2,
  .yourself,
  .guides h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 26px;
    margin: 4px 0 12px;
  }
  .yourself {
    margin-top: 40px;
  }
  .station {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin-top: 28px;
  }
  .station h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    margin: 0 0 12px;
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .station > p {
    max-width: 70ch;
  }
  .guides {
    margin-top: 44px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-card);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-name {
    font-weight: 600;
    font-size: 17px;
  }
</style>
