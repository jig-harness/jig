---
import AuditSpecimen from "../../components/AuditSpecimen.astro";
import SideIndex from "../../components/SideIndex.astro";
import SkillCommand from "../../components/SkillCommand.astro";
import Base from "../../layouts/Base.astro";
import { md, mdInline } from "../../lib/markdown.ts";
import { REPO_URL } from "../../lib/routes.ts";
import { read } from "../../lib/site.ts";
import { paragraphs, sections, withoutTitle } from "../../lib/source.ts";
import { headingId } from "../../lib/view.ts";

const FROM = "plugin/README.md";
const parts = sections(read(FROM));
const intro = paragraphs(withoutTitle(parts[0]?.body ?? ""));
const take = (title: string) => parts.find((p) => p.title === title)?.body ?? "";
const demote = (body: string) => body.replace(/^### /gm, "#### ");
// The five stations from nothing installed to a first audit, each a section
// of the plugin's README; the rest of the README follows, folded.
const STATIONS = [
  { title: "What you need", source: "Requirements" },
  { title: "Install once per machine", source: "Install the plugin" },
  { title: "Use a skill", source: "Use a skill" },
  { title: "Configure the repository", source: "Configure a repository" },
];
const stations = await Promise.all(
  STATIONS.map(async (s, i) => ({ ...s, id: `st-${i + 1}`, html: await md(demote(take(s.source)), FROM) })),
);
const used = new Set(STATIONS.map((s) => s.source));
const rest = await Promise.all(
  parts
    .slice(1)
    .filter((p) => !used.has(p.title))
    .map(async (p) => ({ id: headingId(p.title), title: await mdInline(p.title, FROM), html: await md(demote(p.body), FROM) })),
);
const introHtml = await md(intro.slice(0, 2).join("\n\n"), FROM);
---

<Base title="Install and configure the plugin" description="From nothing installed to your first audit: requirements, install, use, configure.">
  <section class="page wrap with-side">
    <SideIndex
      title="Five stations"
      items={[...stations.map((s, i) => ({ label: s.title, href: `#${s.id}`, num: String(i + 1) })), { label: "Run your first audit", href: "#st-5", num: "5" }]}
    />
    <article class="main">
      <span class="eyebrow">The jig plugin · install and configure</span>
      <h1 class="display">From nothing installed to your first audit.</h1>
      <div class="prose lede-block" set:html={introHtml} />
      {
        stations.map((s, i) => (
          <section class="station" id={s.id}>
            <span class="anchor" id={headingId(s.source)} />
            <h2><span class="num">{i + 1}</span>{s.title}</h2>
            <div class="prose" set:html={s.html} />
          </section>
        ))
      }
      <section class="station" id="st-5">
        <h2><span class="num">5</span>Run your first audit</h2>
        <p>In the repository, start a session and run:</p>
        <SkillCommand name="audit" />
        <p>On a first audit it asks which profile you aim for. What you will see is a sheet like this one, a real run on an open-source library:</p>
        <AuditSpecimen compact />
        <p class="muted small">Then follow <a href="/adopt/">the adoption guide</a>, in the order the sheet ranks.</p>
      </section>
      <h2 class="rest-head">The rest of the plugin guide</h2>
      {
        rest.map((r) => (
          <details class="fold" id={r.id}>
            <summary>
              <span class="fold-title" set:html={r.title} />
              <span class="fold-open">Open</span>
            </summary>
            <div class="prose fold-body" set:html={r.html} />
          </details>
        ))
      }
      <p class="source"><a class="out" href={`${REPO_URL}/blob/main/${FROM}`}>Source: {FROM}</a> · <a href="/plugin/configuration/">Every configuration field</a> · <a href="/plugin/extending/">Extending and adapting Jig</a></p>
    </article>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(30px, 3.2vw, 46px);
    margin: 12px 0 16px;
  }
  .lede-block {
    font-size: 17px;
  }
  .anchor {
    display: block;
    scroll-margin-top: 84px;
  }
  .station {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin-top: 32px;
  }
  .station h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    margin: 0 0 12px;
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .station > p {
    max-width: 70ch;
  }
  .small {
    font-size: 14.5px;
  }
  .rest-head {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    margin: 44px 0 4px;
  }
</style>
