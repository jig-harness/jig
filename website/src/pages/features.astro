---
import ActorChip from "../components/ActorChip.astro";
import ModChip from "../components/ModChip.astro";
import Plate from "../components/Plate.astro";
import SideIndex from "../components/SideIndex.astro";
import Base from "../layouts/Base.astro";
import type { Actor } from "../lib/data/factory.ts";
import { FEATURE_PLATES } from "../lib/data/features.ts";
import { features, skillActor } from "../lib/data/index.ts";
import { md, mdInline } from "../lib/markdown.ts";
import { REPO_URL } from "../lib/routes.ts";
import { stationsRunBy } from "../lib/skills-view.ts";
import { headingId } from "../lib/view.ts";

const FROM = "FEATURES.md";
const f = features();
const introHtml = await md(f.intro, FROM);
// The Practice field beside its module chips: what it says besides the module
// links the chips already show.
const besideModules = (practice: string) =>
  practice
    .replace(/\[M\d+\]\([^)]*\)/g, "")
    .replace(/^[\s,;]+|[\s,;]+$/g, "")
    .replace(/(?:\s*,)+\s*/g, ", ");
const list = await Promise.all(
  f.features.map(async (x, i) => {
    const id = headingId(x.title);
    const plate = FEATURE_PLATES[id];
    if (!plate) throw new Error(`features: no plate for #${id}`);
    return {
      ...x,
      n: i + 1,
      id,
      plate,
      bodyHtml: await md(x.body, FROM),
      practiceHtml: await mdInline(besideModules(x.practice), FROM),
      runs: x.skills.map(skillActor),
      stations: stationsRunBy(...x.skills),
      notBuilt: await Promise.all(
        x.notBuiltEntries.map(async (e) => ({
          html: await mdInline(e.text, FROM),
          todo: [...e.items, ...e.groups].map((item): Actor => ({ kind: "todo", item, text: e.text })),
        })),
      ),
    };
  }),
);
---

<Base title="What you get" description="What a team can run, install or copy from Jig today, each with the practice it carries out and what is on the roadmap.">
  <section class="page wrap">
    <div class="intro-row bleed" style="--bleed-w: min(50vw, 820px); --bleed-shift: 0">
      <div class="intro">
        <span class="eyebrow">What you get · FEATURES.md</span>
        <h1 class="display">What a team gets from Jig, and what runs it.</h1>
        <div class="prose" set:html={introHtml} />
      </div>
      <span class="intro-plate"><Plate name="toolwall" tone={0.66} /></span>
    </div>
    <nav class="glance" aria-labelledby="glance-head">
      <h2 class="glance-head" id="glance-head">At a glance <span class="muted">· {list.length} things you get</span></h2>
      <ol>
        {
          list.map((x) => (
            <li class="card">
              <span class="card-plate"><Plate name={x.plate} /></span>
              <span class="card-text">
                <a class="card-link" href={`#${x.id}`}>
                  <span class="num">{String(x.n).padStart(2, "0")}</span>
                  <span class="card-title">{x.title}</span>
                </a>
                {x.runs.length > 0 && (
                  <span class="card-chips">
                    {x.runs.map((a) => (
                      <ActorChip actor={a} />
                    ))}
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>
  <section class="page wrap with-side detail">
    <SideIndex title={`${list.length} things you get`} items={list.map((x) => ({ label: x.title, href: `#${x.id}`, num: String(x.n) }))} />
    <article class="main" style="--main-max:820px">
      {
        list.map((x) => (
          <section class="feature" id={x.id}>
            <div class="feature-head">
              <h2>
                <span class="num">{x.n}</span>
                {x.title}
              </h2>
              <span class="feature-plate"><Plate name={x.plate} /></span>
            </div>
            <div class="prose" set:html={x.bodyHtml} />
            <dl class="rail">
              {x.runs.length > 0 && (
                <div class="row">
                  <dt>Runs as</dt>
                  <dd class="chips">
                    {x.runs.map((a) => (
                      <ActorChip actor={a} />
                    ))}
                  </dd>
                </div>
              )}
              <div class="row">
                <dt>Practice</dt>
                <dd class="chips">
                  {x.modules.map((m) => (
                    <ModChip id={m} />
                  ))}
                  {x.practiceHtml && <span class="practice" set:html={x.practiceHtml} />}
                </dd>
              </div>
              {x.stations.length > 0 && (
                <div class="row">
                  <dt>In the factory</dt>
                  <dd class="stations">
                    {x.stations.map((s) => (
                      <a href={s.href}>{s.label}</a>
                    ))}
                  </dd>
                </div>
              )}
              {x.notBuilt.length > 0 && (
                <div class="row">
                  <dt>On the roadmap</dt>
                  <dd>
                    <ul class="todo">
                      {x.notBuilt.map((e) => (
                        <li>
                          {e.todo.map((a) => (
                            <ActorChip actor={a} />
                          ))}{" "}
                          <span set:html={e.html} />
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          </section>
        ))
      }
      <p class="source"><a class="out" href={`${REPO_URL}/blob/main/${FROM}`}>Source: {FROM}</a></p>
    </article>
  </section>
</Base>

<style>
  .intro .prose {
    font-size: 16.5px;
  }
  .intro .prose :global(p + p) {
    margin-top: 10px;
  }
  .glance {
    margin-top: 8px;
  }
  .glance-head {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    border-top: 1px solid var(--line);
    padding-top: 10px;
    margin: 0 0 16px;
  }
  .glance-head .muted {
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 13.5px;
  }
  .glance ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 16px 14px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--line-strong);
  }
  .card-plate {
    align-self: center;
    width: 96px;
  }
  .card-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: var(--ink);
  }
  /* The whole card follows the title's link; the chips sit above it. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-link:hover .card-title {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .card-title {
    font-family: var(--serif);
    font-size: 17.5px;
    line-height: 1.25;
    text-wrap: balance;
  }
  .card-chips {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .detail {
    padding-top: 12px;
  }
  .feature {
    border-top: 1px solid var(--line);
    padding: 28px 0 8px;
    scroll-margin-top: 80px;
  }
  .feature-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 0 14px;
  }
  .feature h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
    margin: 0;
    text-wrap: balance;
  }
  .feature .num {
    min-width: 1.6em;
  }
  .feature-plate {
    flex: none;
    width: 112px;
  }
  .rail {
    margin: 4px 0 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14.5px;
  }
  .row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 10px;
    align-items: baseline;
  }
  dt {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
  }
  .practice {
    font-size: 14.5px;
  }
  .stations {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 14px;
  }
  .todo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--muted);
  }
  .source {
    margin-top: 32px;
    font-size: 14px;
  }
  @media (max-width: 1000px) {
    .glance ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .glance ol {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .card {
      flex-direction: row;
      align-items: flex-start;
      padding: 12px;
    }
    .card-plate {
      width: 64px;
      flex: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .feature-plate {
      width: 72px;
    }
  }
</style>
