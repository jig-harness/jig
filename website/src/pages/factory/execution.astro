---
// The line's page had this address once. A bookmark or a link from
// elsewhere still names it, so it forwards to the page that holds the line
// now, its anchor renamed where the new page renamed it and kept otherwise.
import { RENAMED_PAGES } from "../../lib/factory-anchors.ts";

const { to, anchors } = RENAMED_PAGES.execution ?? { to: "line", anchors: {} };
const target = `/factory/${to}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>The line · Jig Harness</title>
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target, anchors }}>
      // The anchor travels with the reader: renamed where the line's page
      // renamed it, as it was otherwise.
      let id = "";
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {}
      const anchor = Object.hasOwn(anchors, id) ? anchors[id] : id;
      location.replace(anchor ? `${target}#${encodeURIComponent(anchor)}` : target);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${target}`} /></noscript>
  </head>
  <body>
    <main>
      <p>This page is now <a href={target}>The line</a>.</p>
    </main>
  </body>
</html>
