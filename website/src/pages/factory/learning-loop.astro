---
import Flywheel from "../../components/factory/Flywheel.astro";
import Plate from "../../components/Plate.astro";
import Base from "../../layouts/Base.astro";
import { factory } from "../../lib/data/index.ts";
import { mdInline } from "../../lib/markdown.ts";
import "../../styles/factory.css";

const f = factory();
const learningHtml = await mdInline(f.learning, "FACTORY.md");
const moreHtml = await Promise.all([...f.learningMore, f.audit].filter(Boolean).map((p) => mdInline(p, "FACTORY.md")));
---

<Base title="The loop that sharpens it" description="How a miss a station should have caught becomes a proven check: the miss-to-lens flywheel from M8, and its two companion cycles.">
  <section class="page wrap">
    <div class="intro-row">
      <div class="intro" id="learning">
        <span class="eyebrow">Jig as a software factory · around both parts</span>
        <h1 class="display">The loop that sharpens it: misses become checks.</h1>
        <p set:html={learningHtml} />
        {moreHtml.map((html) => <p class="muted small" set:html={html} />)}
      </div>
      <span class="intro-plate"><Plate name="flywheel" width="100%" /></span>
    </div>
    <Flywheel />
  </section>
</Base>
