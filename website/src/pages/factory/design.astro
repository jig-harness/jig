---
import DesignLevel from "../../components/factory/DesignLevel.astro";
import Plate from "../../components/Plate.astro";
import Base from "../../layouts/Base.astro";
import { factory } from "../../lib/data/index.ts";
import { mdInline } from "../../lib/markdown.ts";
import { countWord } from "../../lib/view.ts";
import "../../styles/factory.css";

const f = factory();
const level = f.levels.find((l) => l.name === "Deciding what to build");
const lead = await mdInline(f.designLead, "FACTORY.md");
const hands = level ? await mdInline(level.handsOn, "FACTORY.md") : "";
---

<Base title="Deciding what to build" description={`The feature pipeline: ${countWord(f.pipeline.length)} stages from research to an epic of planned work items, each reviewed before the next uses it, and the skills that run them.`}>
  <section class="page wrap">
    <div class="intro-row">
      <div class="intro">
        <span class="eyebrow">Jig as a software factory · before the line</span>
        <h1 class="display">Deciding what to build: the feature pipeline.</h1>
        <p set:html={lead} />
        <p class="muted small">What it hands <a href="/factory/line/">the line</a> is <span set:html={hands} />. <a href="/factory/#levels">Both parts, in figure 2</a>.</p>
      </div>
      <span class="intro-plate"><Plate name="drafting" width="100%" /></span>
    </div>
    <DesignLevel />
  </section>
</Base>
