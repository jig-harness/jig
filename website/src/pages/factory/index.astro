---
import CrossSection from "../../components/CrossSection.astro";
import Boundary from "../../components/factory/Boundary.astro";
import Stations from "../../components/factory/Stations.astro";
import Plate from "../../components/Plate.astro";
import Base from "../../layouts/Base.astro";
import { factory } from "../../lib/data/index.ts";
import { forwardHref, movedFactoryAnchors } from "../../lib/factory-anchors.ts";
import { md, mdInline } from "../../lib/markdown.ts";
import { NAV } from "../../lib/site.ts";
import { FACTORY_PAGE_NOTES } from "../../lib/llms.ts";
import "../../styles/factory.css";

const f = factory();
const moved = Object.fromEntries(
  Object.entries(movedFactoryAnchors(f.jobs.map((j) => j.id))).map(([id, to]) => [id, forwardHref(to)]),
);
const [problem = "", ...frame] = f.intro.slice(0, -1);
const problemHtml = await mdInline(problem, "FACTORY.md");
const frameHtml = await md(frame.join("\n\n"), "FACTORY.md");
const mapHtml = await mdInline(f.intro[f.intro.length - 1] ?? "", "FACTORY.md");
const pages = (NAV.find((n) => n.href === "/factory/")?.pages ?? []).slice(1);
---

<Base title="Jig as a software factory" description="The line every work item travels, what keeps it moving with nobody at the keyboard, and the scaffolding every station stands on.">
  <section class="page wrap">
    <div class="intro-row bleed">
      <div class="intro">
        <span class="eyebrow">Jig as a software factory · FACTORY.md</span>
        <h1 class="display">One line for every change, kept moving when nobody is there.</h1>
        <p class="problem" set:html={problemHtml} />
        <div class="prose" set:html={frameHtml} />
        <p class="muted small" set:html={mapHtml} />
        <p class="muted small">The same skills, sorted by what a team gets from each: <a href="/features/">What you get →</a></p>
      </div>
      <span class="intro-plate"><Plate name="hall" tone={0.72} /></span>
    </div>
    <CrossSection variant="full" />
    <section class="factory-pages" aria-labelledby="fp-head">
      <h2 id="fp-head" class="label">The factory, page by page</h2>
      <ol>
        {
          pages.map((p, i) => (
            <li>
              <a href={p.href}>
                <span class="fp-n">{i + 1}</span>
                <span class="fp-name">{p.label}</span>
                <span class="fp-note">{FACTORY_PAGE_NOTES[p.href]}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
    <Stations />
    <Boundary />
  </section>
  <script is:inline define:vars={{ moved }}>
    // A link into a part of the overview that moved (bookmarked, or shared
    // from elsewhere) is forwarded to where it is now, anchor and all: on
    // load, and when the fragment changes without one.
    const forward = () => {
      let id;
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {
        return;
      }
      if (!Object.hasOwn(moved, id)) return;
      location.replace(moved[id]);
    };
    forward();
    window.addEventListener("hashchange", forward);
  </script>
</Base>

<style>
  /* The overview's list of the factory's pages, after figure 1. */
  .factory-pages {
    margin: 28px 0 0;
  }
  .factory-pages h2 {
    margin: 0 0 10px;
  }
  .factory-pages ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 10px;
  }
  .factory-pages a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--card);
    padding: 10px 12px 12px;
    color: var(--ink);
    text-decoration: none;
  }
  .factory-pages a:hover {
    border-color: var(--accent);
  }
  .fp-n {
    font-family: var(--serif);
    font-size: 12px;
    color: var(--muted);
  }
  .fp-name {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
  }
  .fp-note {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.4;
  }
  .intro .problem {
    font-size: 18px;
    line-height: 1.5;
    max-width: 62ch;
  }
</style>
