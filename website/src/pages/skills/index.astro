---
import ActorLine from "../../components/ActorLine.astro";
import ModChip from "../../components/ModChip.astro";
import StatusMark from "../../components/StatusMark.astro";
import TermInfo from "../../components/TermInfo.astro";
import Base from "../../layouts/Base.astro";
import { type Actor, DESIGN_NOT_BUILT } from "../../lib/data/factory.ts";
import { factory, skills } from "../../lib/data/index.ts";
import { mdInline } from "../../lib/markdown.ts";
import { modulesRunBy, stationsRunBy } from "../../lib/skills-view.ts";

const all = skills();
const rows = await Promise.all(
  all.map(async (s) => ({
    ...s,
    purposeHtml: await mdInline(s.purpose, "plugin/README.md"),
    relationsHtml: s.relations ? await mdInline(s.relations, "plugin/README.md") : "",
    blurbHtml: s.family ? await mdInline(s.family.blurb, "plugin/README.md") : "",
    stations: stationsRunBy(s.name),
    mods: modulesRunBy(s.name),
  })),
);
// The groups in the order the plugin README lists them, then the agent.
const groups: { title?: string; blurbHtml?: string; agent: boolean; rows: typeof rows }[] = [];
for (const r of rows) {
  const title = r.family?.name;
  let g = groups.find((x) => x.agent === r.agent && x.title === title);
  if (!g) groups.push((g = { title, blurbHtml: r.blurbHtml, agent: r.agent, rows: [] }));
  g.rows.push(r);
}
const STATION_NOTE: Record<string, string> = {
  audit: "Inspects the factory itself, outside the stations",
  "promote-memory": "The learning loop around both levels",
  reflect: "The learning loop around both levels",
  "review-reflections": "The learning loop around both levels",
};
const f = factory();
const unrun: { station: string; href: string; actors: Actor[] }[] = [...f.pipeline, ...f.line]
  .map((s) => ({
    station: `${s.id.startsWith("a") ? "Design" : "Execution"} ${s.n} · ${s.name}`,
    href: `/factory/#station-${s.id}`,
    actors: s.actors.filter((a) => a.kind === "person" || a.kind === "todo"),
  }))
  .filter((s) => s.actors.length > 0);
unrun.push({ station: "Design · every stage", href: "/factory/#station-band", actors: [{ kind: "person", note: "accepts each stage's artifact" }, ...DESIGN_NOT_BUILT.everyStage] });
---

<Base title="Skills" description="The skills that run Jig's modules for you, and the stations no skill runs.">
  <section class="page wrap">
    <div class="intro">
      <span class="eyebrow">Skills · {all.filter((s) => !s.agent).length} skills and 1 agent</span>
      <h1 class="display">The skills that run Jig's modules for you.</h1>
      <p>They all come from one plugin, installed once per machine: <a href="/plugin/">install and configure it</a>.</p>
    </div>
    <div class="th"><span aria-hidden="true">Skill</span><span aria-hidden="true">What it does</span><span><span aria-hidden="true">Runs station</span><TermInfo term="station" /></span><span aria-hidden="true">Runs module</span></div>
    {
      groups.map((g) => (
        <>
          {g.agent ? (
            <>
              <h2 class="h2">Agent</h2>
              <p class="muted small">In Claude Code, skills call it themselves when a finding is contested; you do not invoke it by hand. Codex plugins carry no agents: see the <a href="/plugin/#codex-notes">Codex notes</a>.</p>
            </>
          ) : (
            g.title && (
              <>
                <h2 class="h2">{g.title}</h2>
                {g.blurbHtml && <p class="muted small" set:html={g.blurbHtml} />}
              </>
            )
          )}
          <ol class="rows">
            {g.rows.map((s) => (
              <li>
                <a class="name" href={`/skills/${s.name}/`}>{s.name}</a>
                <span class="purpose">
                  <span set:html={s.purposeHtml} />
                  {s.relationsHtml && (
                    <span class="relations">
                      <span class="rel-label">Works with</span> <span set:html={s.relationsHtml} />
                    </span>
                  )}
                </span>
                <span class="stations">
                  {s.stations.map((t) => (
                    <a href={t.href}>
                      <StatusMark kind="skill" />
                      <span class="vh">Runs station: </span>
                      <span>{t.label}</span>
                    </a>
                  ))}
                  {s.stations.length === 0 && <span class="muted">{STATION_NOTE[s.name] ?? "Used at many stations"}</span>}
                </span>
                <span class="mods">
                  {s.mods.map((m) => <ModChip id={m.id} />)}
                  {s.mods.length === 0 && <span class="muted">{s.agent ? "Called by the review skills" : "Supports every module; runs none on its own"}</span>}
                </span>
              </li>
            ))}
          </ol>
        </>
      ))
    }
    <h2 class="h2" id="unrun">Stations no skill runs<TermInfo term="station" /></h2>
    <p class="muted small">From <a href="/factory/">the factory page</a>: the stations a person runs, and the ones not built yet, with their roadmap item.</p>
    <ul class="unrun">
      {
        unrun.map((u) => (
          <li>
            <a href={u.href}>{u.station}</a>
            <span class="actors">{u.actors.map((a) => <ActorLine actor={a} />)}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .th,
  .rows li {
    display: grid;
    grid-template-columns: 250px minmax(0, 1.6fr) minmax(0, 1fr) 150px;
    gap: 6px 28px;
  }
  .th {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .name {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .purpose {
    font-size: 15px;
    line-height: 1.55;
  }
  .relations {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .rel-label {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .stations {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    font-size: 13.5px;
    line-height: 1.35;
  }
  .stations a {
    display: flex;
    gap: 7px;
    align-items: flex-start;
  }
  .stations :global(.mark) {
    margin-top: 3px;
  }
  .mods {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 13.5px;
  }
  .h2 {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 500;
    margin: 34px 0 4px;
  }
  .small {
    margin: 0 0 10px;
    font-size: 14.5px;
    max-width: 72ch;
  }
  .unrun {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .unrun li {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 4px 28px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .actors {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .actors :global(.actor) {
    font-size: 14.5px;
  }
  @media (max-width: 1079px) {
    .th {
      display: none;
    }
    .rows li,
    .unrun li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
