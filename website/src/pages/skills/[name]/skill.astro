---
import SideIndex from "../../../components/SideIndex.astro";
import Base from "../../../layouts/Base.astro";
import { skills } from "../../../lib/data/index.ts";
import { type Doc as DocEntry, docsMatching, titleOf } from "../../../lib/docs.ts";
import { md } from "../../../lib/markdown.ts";
import { REPO_URL } from "../../../lib/routes.ts";
import { withoutTitle } from "../../../lib/source.ts";

// The agent-facing contract of a skill whose main page is its human README.
export async function getStaticPaths() {
  const readmes = new Set((await docsMatching(/^plugin\/skills\/[^/]+\/README$/)).map((e) => e.id.split("/")[2]));
  const contracts = await docsMatching(/^plugin\/skills\/[^/]+\/SKILL$/);
  return contracts
    .filter((e) => readmes.has(e.id.split("/")[2]))
    .map((entry) => ({ params: { name: entry.id.split("/")[2] ?? entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { name } = Astro.params as { name: string };
const from = `${entry.id}.md`;
const html = await md(withoutTitle((entry.body ?? "").replace(/^---[\s\S]*?---\n/, "")), from);
const all = skills();
---

<Base title={`${titleOf(entry)}: the agent's contract`}>
  <section class="page wrap with-side">
    <SideIndex title={`${all.filter((s) => !s.agent).length} skills, 1 agent`} items={all.map((s) => ({ label: s.name, href: `/skills/${s.name}/`, current: s.name === name }))} />
    <article class="main" style="--main-max:800px">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/skills/">Skills</a><span aria-hidden="true">/</span><a href={`/skills/${name}/`}>{name}</a><span aria-hidden="true">/</span><span>SKILL.md</span></nav>
      <span class="label">The agent's contract</span>
      <h1>{name}</h1>
      <p class="muted">The procedure an agent follows when it runs <code>{name}</code>. For people, <a href={`/skills/${name}/`}>the {name} guide</a> explains it.</p>
      <div class="prose" set:html={html} />
      <p class="source"><a class="out" href={`${REPO_URL}/blob/main/${from}`}>Source: {from}</a></p>
    </article>
  </section>
</Base>

<style>
  h1 {
    margin: 8px 0 10px;
    font-family: var(--mono);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 500;
  }
</style>
