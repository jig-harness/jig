// Flags a process-wide exit or signal handler registered ad hoc: each one
// runs in registration order with every other, so release order is decided by
// load order rather than by the code that owns the resource. The call is
// matched as written; an alias of process.on or process.once is not followed.
// The shared cleanup kernel owns the process-wide registrations. $filename
// is absolute, so the exemption matches a path suffix; grit.test.ts fails if
// any tracked file other than the kernel ends in that suffix.
or { `process.on($event, $handler)`, `process.once($event, $handler)` } as $register where {
  $event <: or { `"exit"`, `"SIGINT"`, `"SIGTERM"`, `"SIGHUP"` },
  not $filename <: r".*plugin[/\\]shared[/\\]cleanup\.ts$",
  register_diagnostic(
    span = $register,
    message = "jig/no-bare-signal-handlers: an ad hoc process exit or signal handler. Register cleanup in one place that releases in order.",
    severity = "error"
  )
}
